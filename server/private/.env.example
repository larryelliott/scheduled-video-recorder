# Copy to .env (same folder) and fill in. Never commit .env.
# Make random tokens with:  php -r "echo bin2hex(random_bytes(24)), PHP_EOL;"

# --- Where the site lives -------------------------------------------------------------------------
BASE_URL=https://example.org/video-manager
BASE_PATH=/video-manager
APP_TIMEZONE=America/Detroit

# --- Secrets ----------------------------------------------------------------------------------------
AGENT_TOKEN=
ESP_TOKEN=
# One-time key for the first-run page https://example.org/video-manager/setup?key=SETUP_KEY (works only until the first person exists)
SETUP_KEY=

# --- Schedule: a Google Sheet shared as "anyone with the link can view" ---------------------------------
SHEET_ID=
SHEET_GID=0
# Easiest: paste the sheet's normal address (the one in your browser). It is used to read the schedule when SHEET_ID is blank,
# and it is the link behind "Open schedule spreadsheet" on the website. Use SHEET_ID + SHEET_GID instead if you prefer.
SHEET_URL=
# Optional: use a published CSV link instead
# SHEET_CSV_URL=
# Optional: used when a row has a date but no time
# DEFAULT_SERVICE_TIME=10:30 AM

# --- Recording window -----------------------------------------------------------------------------------
RECORD_LEAD_MINUTES=10
RECORD_MAX_MINUTES=100

# --- Sermon cut detection (pulpit light) ------------------------------------------------------------------
CUT_LUX_ON=100
CUT_LUX_OFF=50
CUT_MIN_SECONDS=180
CUT_MAX_SECONDS=5400
# Seconds added before the light turns on / after it turns off. Negative values trim inward.
CUT_PAD_START_SECONDS=0
CUT_PAD_END_SECONDS=0

# --- Video intro card ---------------------------------------------------------------------------------------
INTRO_TITLE=Pastor Name's Sermons
INTRO_TEXT1=Welcome to Your Church
INTRO_TEXT2=123 Main Street, Your Town
INTRO_TEXT3=yourchurch.org
INTRO_SECONDS=5
# ffmpeg colours (0xRRGGBB) and the font file on the Windows PC
INTRO_BG=0x000000
INTRO_FG=0xFFFFFF
INTRO_ACCENT=0x7F0000
INTRO_FONT=C:/Windows/Fonts/arial.ttf

# --- Retention and alerts --------------------------------------------------------------------------------------
FILE_RETENTION_DAYS=14
AGENT_OFFLINE_MINUTES=60
ESP_OFFLINE_MINUTES=120

# --- Automatic recording ---------------------------------------------------------------------------------------------
# If the pulpit light turns on and no recording is scheduled, record until the light goes off or this many minutes pass.
AUTO_LIGHT_RECORD=1
AUTO_LIGHT_MAX_MINUTES=30

# --- Notifications ---------------------------------------------------------------------------------------------------
NTFY_SERVER=https://ntfy.sh
# Email. With SMTP_HOST blank, PHP's mail() is used, which many hosts block or send to spam.
# For reliable email, fill in a real mailbox (see docs/NOTIFICATIONS.md). Use Settings > "Send me a test email" to check.
MAIL_FROM=video@example.org
SMTP_HOST=
SMTP_PORT=587
# tls = STARTTLS (port 587), ssl = implicit TLS (port 465), none = no encryption
SMTP_SECURE=tls
SMTP_USER=
SMTP_PASS=
# Set to 0 only if the mail server's certificate name does not match SMTP_HOST
SMTP_VERIFY_PEER=1
