# Copy to .env (same folder as this file) and fill in.

SERVER_URL=https://example.org/video-manager
# Same value as AGENT_TOKEN in the server .env
AGENT_TOKEN=

# OBS: Tools > WebSocket Server Settings > enable, port 4455, set a password
OBS_HOST=localhost
OBS_PORT=4455
OBS_PASSWORD=
OBS_EXE=C:\Program Files\obs-studio\bin\64bit\obs64.exe
# Stops OBS from asking about "safe mode" after an unclean shutdown
OBS_ARGS=--disable-shutdown-check

# Where OBS saves recordings. Leave this BLANK: the agent asks OBS where it saves (and falls back to your Videos folder).
# Only set it if the agent cannot find recordings, and then it must be the same folder as OBS > Settings > Output > Recording Path.
RECORD_DIR=
# Where finished videos are kept on this PC
OUTPUT_DIR=C:\Users\YourName\Documents\sermon-videos

# ffmpeg and ffprobe (full paths if they are not on PATH)
FFMPEG=ffmpeg
FFPROBE=ffprobe

# How the finished video is encoded. Software x264 works everywhere; 'veryfast' is about twice as fast as 'fast'.
# A lower CRF means better quality and a bigger file (18 = very high, 23 = good, 28 = small).
X264_PRESET=veryfast
X264_CRF=23
# Hardware encoding is much faster if your PC has a suitable GPU. Examples (try one, then run a test recording):
#   VIDEO_ENCODER=h264_nvenc    VIDEO_ENCODER_ARGS=-preset p4 -rc vbr -cq 23 -b:v 0
#   VIDEO_ENCODER=h264_qsv      VIDEO_ENCODER_ARGS=-global_quality 23
#   VIDEO_ENCODER=h264_amf      VIDEO_ENCODER_ARGS=-quality balanced -rc cqp -qp_i 23 -qp_p 23
VIDEO_ENCODER=libx264
VIDEO_ENCODER_ARGS=

# Seconds between check-ins with the server
HEARTBEAT_SECONDS=20
# Set to 0 to keep finished videos on this PC only
UPLOAD_TO_SERVER=1
